{
  "name": "velocitrack",
  "version": "0.17.0",
  "private": true,
  "description": "A private, local workspace for recorded VelociRadar measurements",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:public": "node scripts/check-public.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests public/sources/*.json *.ts *.mjs *.json index.html",
    "format:check": "prettier --check src tests public/sources/*.json *.ts *.mjs *.json index.html",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:public"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "lucide-react": "1.59.0",
    "papaparse": "5.7.0",
    "pdfmake": "0.3.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
